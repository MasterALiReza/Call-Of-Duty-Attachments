* text=auto

# Enforce LF for bash scripts and python files
*.sh text eol=lf
*.py text eol=lf
scripts/ox-loadout text eol=lf
.env.example text eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.md text
*.txt text
*.json text
*.yaml text
*.yml text

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
