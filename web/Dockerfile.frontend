# Stage 1: Build
FROM node:20-alpine AS build

WORKDIR /app

COPY web/frontend/package*.json ./
RUN npm ci

COPY web/frontend ./
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
